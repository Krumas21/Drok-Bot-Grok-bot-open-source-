# ─── Required ───────────────────────────────────────────────────────────────
# Password for the web UI. The UI controls agents that have shell access - make it strong.
DROK_ADMIN_PASSWORD=
# Shared secret between the core and the computer container. scripts/setup.sh fills it in.
COMPUTER_TOKEN=

# ─── LLM providers (set at least one) ───────────────────────────────────────
# Models are written provider/model, e.g. anthropic/claude-sonnet-5-5, openai/gpt-5-mini,
# openrouter/x-ai/grok-4, ollama/qwen3:32b. Each agent picks its own model + fallbacks in the UI.
DROK_DEFAULT_MODEL=openai/gpt-5-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
# Local models (Ollama, LM Studio on the host machine):
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Any other OpenAI-compatible server: DROK_PROVIDER_<NAME>_BASE_URL (+ _API_KEY), used as <name>/<model>
# DROK_PROVIDER_VLLM_BASE_URL=http://192.168.1.50:8000/v1
# DROK_PROVIDER_VLLM_API_KEY=

# ─── Telegram (talk to your lead agent from anywhere) ───────────────────────
# Create a bot with @BotFather. Leave the allowlist empty, message the bot once, and it replies with your id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# ─── Safety ─────────────────────────────────────────────────────────────────
# Independent model that reviews risky tool calls (shell, browser actions, MCP). Empty = each agent's own model.
DROK_AUTO_REVIEW=on
DROK_REVIEWER_MODEL=
# Routines pause themselves after this many days without hearing from you (0 = never).
DROK_ABSENCE_DAYS=14

# ─── Harness ────────────────────────────────────────────────────────────────
# Model for background work: conversation summaries, context compression, self-improvement reflection and
# goal verification. A fast, cheap model is ideal. Empty = reviewer model, else each agent's own model.
DROK_AUX_MODEL=
# Agents reflect after substantial work and save memory + skills on their own.
DROK_LEARNING=on
# Long turns compress their middle into a checkpoint beyond this many characters (~4 chars per token).
DROK_CONTEXT_CHARS=320000

# ─── Google (Gmail, Drive, Calendar) ────────────────────────────────────────
# OAuth client of type "Desktop app" from console.cloud.google.com - then press Connect on the Settings page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Optional ───────────────────────────────────────────────────────────────
DROK_OWNER_NAME=the owner
TZ=UTC
DROK_PORT=8080
# 127.0.0.1 = only this machine; 0.0.0.0 = your LAN. Use Tailscale/WireGuard for remote access, not port forwarding.
DROK_BIND=0.0.0.0
# How links in Telegram messages reach the UI, e.g. http://homeserver.local:8080
DROK_PUBLIC_URL=http://localhost:8080
DROK_SCREENS=4
DROK_MAX_STEPS=40
# Search API for web_search (otherwise a keyless DuckDuckGo fallback is used - fine for light use)
BRAVE_API_KEY=
SEARXNG_URL=
# Voice notes on Telegram: provider/model for speech-to-text and text-to-speech
DROK_STT_MODEL=
DROK_TTS_MODEL=
DROK_TTS_VOICE=alloy
